<Window x:Class="ArkaCode.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ArkaCode" Width="1480" Height="900" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#09121E" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="15"/></Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="45"/><Setter Property="Height" Value="45"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FontSize" Value="18"/></Style>
    <Style x:Key="EffortStyle" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="#0C1725"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="EffortBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="EffortBorder" Property="Background" Value="#183D35"/><Setter TargetName="EffortBorder" Property="BorderBrush" Value="#61E2C2"/><Setter Property="Foreground" Value="#61E2C2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="ChatTemplate">
      <Border Margin="0,0,0,14" Padding="14" CornerRadius="12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#101B2A"/><Style.Triggers><DataTrigger Binding="{Binding IsAgent}" Value="True"><Setter Property="Background" Value="#122B29"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="9" Background="#20334A" VerticalAlignment="Top"><TextBlock Text="{Binding Role}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#61E2C2"/></Border>
          <StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" Foreground="#DDE8F3"/></StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0C1725" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="11" Background="#61E2C2"><TextBlock Text="✦" Foreground="#06221C" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="ArkaCode" FontWeight="Bold" FontSize="17"/><TextBlock Text="AGENTIC DEVELOPMENT" Foreground="{StaticResource Muted}" FontSize="7"/></StackPanel></StackPanel>
        <Border Grid.Column="1" Background="#111E2E" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="8,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⌂" Foreground="{StaticResource Mint}" VerticalAlignment="Center"/><TextBox x:Name="WorkspacePathBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontFamily="Segoe UI" FontSize="11" Padding="7,3" IsReadOnly="True"/><Button Grid.Column="2" Content="انتخاب Workspace" Click="ChooseWorkspace_Click" Padding="10,5"/></Grid></Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Mint}"/><TextBlock Text="AiBus Connected" Margin="7,0,14,0" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button Content="تنظیمات اتصال" Click="ToggleSettings_Click"/></StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="235"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
      <Border Background="#0A1420" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><StackPanel Margin="8,14"><Button Style="{StaticResource NavButton}" Content="⌘" ToolTip="Agent" Background="#18352F" BorderBrush="#3E8D78"/><Button Style="{StaticResource NavButton}" Content="⌕" ToolTip="Search"/><Button Style="{StaticResource NavButton}" Content="⑂" ToolTip="Source Control"/><Button Style="{StaticResource NavButton}" Content="▹" ToolTip="Run"/><Button Style="{StaticResource NavButton}" Content="⚙" ToolTip="Settings"/></StackPanel></Border>

      <Border Grid.Column="1" Background="#0E1927" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="145"/></Grid.RowDefinitions>
        <DockPanel Margin="12,0"><TextBlock Text="EXPLORER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Style="{StaticResource IconButton}" Content="↻" HorizontalAlignment="Right" Click="RefreshFiles_Click"/></DockPanel>
        <ListBox x:Name="FilesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#B8C9DA" FontFamily="Consolas" FontSize="11" SelectionChanged="FilesList_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#1A3044"/><Setter Property="Foreground" Value="#61E2C2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#14263A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
        <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12"><StackPanel><TextBlock Text="WORKSPACE CONTEXT" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="ContextStats" Text="هیچ پوشه‌ای انتخاب نشده" TextWrapping="Wrap" Margin="0,8" FontSize="11"/><ProgressBar x:Name="ContextProgress" Height="5" Maximum="100" Value="0" Foreground="{StaticResource Mint}" Background="#1D2A3A"/><TextBlock Text="فایل‌های متنی منتخب با سقف امن برای عامل ارسال می‌شوند." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
      </Grid></Border>

      <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="#0A1420"/>

      <Grid Grid.Column="3" Background="#0A1320"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
        <Border Background="#101C2B" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><DockPanel><StackPanel Orientation="Horizontal"><Border x:Name="EditorTab" Background="#0A1320" BorderBrush="{StaticResource Mint}" BorderThickness="0,0,0,2" Padding="16,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#61E2C2" FontSize="8" Margin="0,0,8,0"/><TextBlock x:Name="EditorTitle" Text="Welcome" FontFamily="Consolas" FontSize="11"/></StackPanel></Border></StackPanel><Button Style="{StaticResource IconButton}" Content="ذخیره" HorizontalAlignment="Right" Margin="0,4,8,4" Click="SaveFile_Click"/></DockPanel></Border>
        <TextBox x:Name="EditorBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="18,16" FontSize="13" TextWrapping="NoWrap" IsReadOnly="True" Text="ArkaCode آماده است. یک Workspace انتخاب کنید و وظیفه برنامه‌نویسی را برای عامل بنویسید."/>
        <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Background="#0C1623"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="12,0"><TextBlock Text="CHANGE PREVIEW" Foreground="{StaticResource Mint}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ChangeCount" Text="0 فایل" Foreground="{StaticResource Muted}" FontSize="10" Margin="14,0" VerticalAlignment="Center"/><Button x:Name="ApplyButton" Content="اعمال تغییرات تأییدشده" IsEnabled="False" Click="ApplyChanges_Click" Margin="8,3"/></StackPanel><TextBox x:Name="PreviewBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="14,10" FontSize="11" Foreground="#AFC1D4" Text="خروجی عامل و فایل‌های پیشنهادی اینجا نمایش داده می‌شوند."/></Grid></Border>
      </Grid>

      <Border Grid.Column="4" Background="#0E1927" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="SettingsPanel" Background="#132237" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="AiBus Base URL" FontSize="9" Foreground="{StaticResource Muted}"/><TextBox x:Name="BaseUrlBox" Text="https://aibus.00f.ir" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="API Key (در حافظه موقت)" FontSize="9" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="ApiKeyBox" Margin="0,5,0,0" Background="#0C1522" Foreground="White" BorderBrush="{StaticResource Border}" Padding="8"/></StackPanel><Button Grid.Row="1" Grid.ColumnSpan="2" Content="اتصال و دریافت مدل‌ها" Click="Connect_Click" Margin="0,10,0,0"/></Grid></Border>
        <Border Grid.Row="1" Background="#111F30" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14"><StackPanel><DockPanel><StackPanel><TextBlock Text="AGENT MODEL" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="مدل و سطح هوشمندی" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/></StackPanel><TextBlock x:Name="ConnectionBadge" Text="نیازمند اتصال" Foreground="#FFB86B" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><ComboBox x:Name="ModelCombo" DisplayMemberPath="Label" Margin="0,12,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="EffortLow" Content="Low" GroupName="Effort" Tag="low" Style="{StaticResource EffortStyle}"/><RadioButton x:Name="EffortMedium" Grid.Column="1" Content="Medium" GroupName="Effort" Tag="medium" IsChecked="True" Style="{StaticResource EffortStyle}"/><RadioButton x:Name="EffortHigh" Grid.Column="2" Content="High" GroupName="Effort" Tag="high" Style="{StaticResource EffortStyle}"/><RadioButton x:Name="EffortXHigh" Grid.Column="3" Content="XHigh" GroupName="Effort" Tag="xhigh" Style="{StaticResource EffortStyle}"/></Grid></StackPanel></Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14"><ItemsControl x:Name="ChatList" ItemTemplate="{StaticResource ChatTemplate}"/></ScrollViewer>
        <Border Grid.Row="3" Background="#111F30" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="13"><StackPanel><TextBox x:Name="PromptBox" MinHeight="92" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="PromptBox_PreviewKeyDown"/><DockPanel Margin="0,9,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Enter برای اجرا · Shift+Enter خط جدید" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/><TextBlock x:Name="RunStatus" Foreground="{StaticResource Mint}" FontSize="9" Margin="10,0" VerticalAlignment="Center"/></StackPanel><Button x:Name="RunButton" Content="اجرای Agent  ↑" Click="RunAgent_Click" HorizontalAlignment="Right" Background="#61E2C2" Foreground="#06231D" BorderBrush="#61E2C2" FontWeight="Bold"/></DockPanel></StackPanel></Border>
      </Grid></Border>
    </Grid>

    <Border Grid.Row="2" Background="#112B28"><DockPanel Margin="10,0"><TextBlock Text="✦ ArkaCode" Foreground="{StaticResource Mint}" FontSize="9" VerticalAlignment="Center"/><TextBlock x:Name="FooterStatus" Text="Safe workspace mode · Review before apply" Foreground="#A8C5BF" FontSize="9" VerticalAlignment="Center" Margin="14,0"/><TextBlock Text="AiBus Gateway" Foreground="#A8C5BF" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
</Window>
