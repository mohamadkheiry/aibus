<Application x:Class="ArkaCode.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Panel" Color="#111C2B"/>
    <SolidColorBrush x:Key="Panel2" Color="#162438"/>
    <SolidColorBrush x:Key="Border" Color="#263850"/>
    <SolidColorBrush x:Key="Text" Color="#F4F8FC"/>
    <SolidColorBrush x:Key="Muted" Color="#8EA3BC"/>
    <SolidColorBrush x:Key="Mint" Color="#61E2C2"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#61E2C2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#0C1522"/><Setter Property="CaretBrush" Value="{StaticResource Mint}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="Foreground" Value="#071B18"/><Setter Property="Background" Value="#D8E4EF"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8,5"/></Style>
  </Application.Resources>
</Application>
