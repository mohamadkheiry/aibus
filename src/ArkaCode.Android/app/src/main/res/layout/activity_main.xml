<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/arka_bg" android:fitsSystemWindows="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:background="@color/arka_panel">
    <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="✦" android:textSize="22sp" android:textColor="@color/arka_dark_mint" android:background="@drawable/button_primary"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ArkaCode" android:textColor="@color/arka_text" android:textStyle="bold" android:textSize="19sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AGENTIC MOBILE STUDIO" android:textColor="@color/arka_muted" android:textSize="8sp"/></LinearLayout>
    <TextView android:id="@+id/statusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Offline" android:textColor="@color/arka_warning" android:textSize="11sp"/>
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/panel">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اتصال امن AiBus" android:textColor="@color/arka_text" android:textStyle="bold" android:textSize="15sp"/>
      <EditText android:id="@+id/baseUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/field" android:text="https://aibus.00f.ir" android:textColor="@color/arka_text" android:textColorHint="@color/arka_muted" android:textSize="13sp" android:inputType="textUri" android:singleLine="true"/>
      <EditText android:id="@+id/apiKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/field" android:hint="aibus_... API Key" android:textColor="@color/arka_text" android:textColorHint="@color/arka_muted" android:textSize="13sp" android:inputType="textPassword" android:singleLine="true"/>
      <Button android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="اتصال و دریافت مدل‌ها" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/arka_dark_mint" android:background="@drawable/button_primary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/panel">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مدل برنامه‌نویسی" android:textColor="@color/arka_muted" android:textSize="10sp"/>
      <Spinner android:id="@+id/modelSpinner" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="5dp" android:background="@drawable/field" android:popupBackground="@color/arka_panel_2"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="سطح هوشمندی" android:textColor="@color/arka_muted" android:textSize="10sp"/>
      <RadioGroup android:id="@+id/effortGroup" android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:layout_marginTop="5dp"><RadioButton android:id="@+id/effortLow" style="@style/EffortButton" android:text="Low"/><RadioButton android:id="@+id/effortMedium" style="@style/EffortButton" android:text="Medium" android:checked="true"/><RadioButton android:id="@+id/effortHigh" style="@style/EffortButton" android:text="High"/><RadioButton android:id="@+id/effortXHigh" style="@style/EffortButton" android:text="XHigh"/></RadioGroup>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/panel">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Workspace پروژه" android:textColor="@color/arka_text" android:textStyle="bold" android:textSize="15sp"/>
      <TextView android:id="@+id/workspaceLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="پوشه‌ای انتخاب نشده است" android:textColor="@color/arka_muted" android:textSize="11sp" android:maxLines="2"/>
      <Button android:id="@+id/workspaceButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="انتخاب پوشه پروژه" android:textAllCaps="false" android:textColor="@color/arka_text" android:background="@drawable/button_secondary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/panel">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="دستور Agent" android:textColor="@color/arka_text" android:textStyle="bold" android:textSize="15sp"/>
      <EditText android:id="@+id/taskInput" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="10dp" android:gravity="top|start" android:background="@drawable/field" android:hint="مثلاً: ساختار این پروژه را بررسی کن و صفحه ورود را اصلاح کن..." android:textColor="@color/arka_text" android:textColorHint="@color/arka_muted" android:textSize="14sp" android:inputType="textMultiLine"/>
      <Button android:id="@+id/runButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="اجرای Agent  ↑" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/arka_dark_mint" android:background="@drawable/button_primary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/panel">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="خروجی و پیش‌نمایش تغییرات" android:textColor="@color/arka_mint" android:textStyle="bold" android:textSize="14sp"/>
      <TextView android:id="@+id/outputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="120dp" android:layout_marginTop="10dp" android:text="ArkaCode آماده است. ابتدا اتصال و Workspace را تنظیم کنید." android:textColor="@color/arka_text" android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true"/>
      <Button android:id="@+id/applyButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="اعمال تغییرات تأییدشده" android:textAllCaps="false" android:textColor="@color/arka_dark_mint" android:background="@drawable/button_primary" android:enabled="false"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="18dp" android:text="Safe workspace mode · Review before apply · AiBus Gateway" android:textColor="@color/arka_muted" android:textSize="9sp"/>
  </LinearLayout></ScrollView>
</LinearLayout>
